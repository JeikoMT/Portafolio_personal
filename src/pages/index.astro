---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Hero from '../sections/Hero.astro';
import About from '../sections/About.astro';
import Areas from '../sections/Areas.astro';
import Tools from '../sections/Tools.astro';
import Experience from '../sections/Experience.astro';
import Projects from '../sections/Projects.astro';
import Method from '../sections/Method.astro';
import Assessments from '../sections/Assessments.astro';
import Education from '../sections/Education.astro';
import Certificates from '../sections/Certificates.astro';
import Posts from '../sections/Posts.astro';
import Contact from '../sections/Contact.astro';
import { getProfile, getEvents } from '../lib/content';

const profile = await getProfile();
const hasEvents = (await getEvents()).length > 0;
---
<BaseLayout title={`${profile.name} · ${profile.headline}`} description={`${profile.tagline} ${profile.description}`.slice(0, 200)}>
  <div class="page" id="inicio">
    <Navbar name={profile.name} subtitle={profile.navSubtitle} showEvents={hasEvents} />
    <main>
      <Hero />
      <About />
      <Areas />
      <Tools />
      <Experience />
      <Projects />
      <Method />
      <Assessments />
      <Education />
      <Certificates />
      <Posts />
      <Contact />
    </main>
    <Footer linkedinUrl={profile.contact.linkedinUrl} />
  </div>
</BaseLayout>
