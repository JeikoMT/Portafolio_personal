---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Badge from '../../components/Badge.astro';
import Chip from '../../components/Chip.astro';
import Icon from '../../components/Icon.astro';
import ImageCarousel from '../../components/ImageCarousel.astro';
import ProjectToc from '../../components/ProjectToc.astro';
import ArchDiagram from '../../components/ArchDiagram.astro';
import EntityGrid from '../../components/EntityGrid.astro';
import { getProfile, getProjects, getEvents } from '../../lib/content';
import { parseSections, statusTone } from '../../lib/ui';
import ui from '../../data/sections.json';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const p = entry.data;
const profile = await getProfile();
const hasEvents = (await getEvents()).length > 0;
const sections = parseSections(entry.body);
const hasLinks = Boolean(p.repoUrl || p.demoUrl);
const screenshots = p.screenshots ?? [];
const ogCover = p.cover ? (await getImage({ src: p.cover, width: 1200, height: 630, fit: 'cover', format: 'png' })).src : undefined;
const placeholderAlt = `${ui.projects.coverPrefix} ${p.title}: ${p.coverNote ?? ''}`.trim();
---
<BaseLayout title={`${p.title} · ${profile.name}`} description={p.summary.slice(0, 200)} ogImage={ogCover}>
  <div class="page">
    <Navbar variant="project" name={profile.name} subtitle={profile.navSubtitle} showEvents={hasEvents} />
    <main class="container proj">
      <a class="back" href="/#proyectos" data-back-to-projects>
        <Icon name="arrow-left" size={18} />{ui.projectPage.back}
      </a>

      <header class="head">
        <Badge tone={statusTone[p.status] ?? 'idea'} size="md" dot>{p.status}</Badge>
        <h1 class="head__title">{p.title}</h1>
        <p class="head__summary">{p.summary}</p>
        <ul class="head__stack">
          {(p.stackDetail ?? p.stack).map((s) => <li><Chip variant="stack">{s}</Chip></li>)}
        </ul>
      </header>

      <div class="cover">
        {screenshots.length > 0 ? (
          <ImageCarousel title={p.title} slides={screenshots} />
        ) : (
          <figure class="cover__ph glass">
            <div class="cover__stage" role="img" aria-label={placeholderAlt}>
              <span class="cover__note">{p.coverNote}</span>
            </div>
            <figcaption class="cover__caption"><Icon name="monitor" size={14} />{ui.projectPage.fictitious}</figcaption>
          </figure>
        )}
      </div>

      <div class="layout">
        {sections.length >= 3 && <ProjectToc sections={sections} />}
        <article class="article">
          {sections.map((s) => (
            <section class="block solid" id={s.id}>
              <h2 class="block__title">{s.title}</h2>
              {s.paragraphs.map((para) => <p class="block__p">{para}</p>)}
              {s.title === 'Arquitectura' && p.diagram && <ArchDiagram name={p.diagram} />}
              {s.title === 'Modelo de datos' && p.entities && <EntityGrid entities={p.entities} />}
            </section>
          ))}

          {hasLinks && (
            <div class="links">
              {p.repoUrl && (
                <a class="btn btn--dark" href={p.repoUrl} target="_blank" rel="noopener noreferrer"><Icon name="github" size={20} />{ui.projectPage.repo}</a>
              )}
              {p.demoUrl && (
                <a class="btn btn--glass" href={p.demoUrl} target="_blank" rel="noopener noreferrer"><Icon name="external-link" size={20} />{ui.projectPage.demo}</a>
              )}
            </div>
          )}
        </article>
      </div>
    </main>
    <Footer linkedinUrl={profile.contact.linkedinUrl} />
  </div>
</BaseLayout>

<style>
  .proj { padding-top: clamp(32px, 5vw, 56px); padding-bottom: clamp(64px, 8vw, 96px); }
  .back {
    display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; padding: 0 14px 0 10px; margin-left: -10px;
    border-radius: var(--radius-pill); font-size: var(--fs-16); font-weight: 600; color: var(--color-primary); text-decoration: none;
  }
  .back:hover { background: var(--color-primary-soft); color: var(--color-primary); }
  .head { display: flex; flex-direction: column; gap: var(--space-4); margin-top: var(--space-5); max-width: 820px; }
  .head__title { font-size: clamp(var(--fs-40), 5vw, var(--fs-56)); line-height: 1.05; font-weight: 700; letter-spacing: -0.02em; }
  .head__summary { font-size: clamp(var(--fs-18), 2vw, var(--fs-20)); line-height: 1.55; color: var(--color-text-muted); }
  .head__stack { display: flex; flex-wrap: wrap; gap: 6px; }
  .cover { margin-top: var(--space-8); }
  .cover__ph { margin: 0; padding: 10px; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); }
  .cover__stage {
    aspect-ratio: 4 / 3; border-radius: var(--radius-md); display: grid; place-items: center; padding: var(--space-3);
    background: repeating-linear-gradient(135deg, var(--color-primary-soft) 0 12px, var(--color-bg) 12px 24px);
    border: 1px solid rgba(29, 78, 216, 0.1);
  }
  .cover__note {
    font: 500 var(--fs-14) ui-monospace, Menlo, monospace; color: var(--color-primary); background: var(--color-surface-solid);
    padding: 6px 10px; border-radius: 6px; text-align: center;
  }
  .cover__caption { display: flex; align-items: center; gap: 6px; padding: 10px 6px 2px; font-size: var(--fs-12); font-weight: 600; color: var(--color-text-muted); }

  .layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(32px, 5vw, 64px); margin-top: clamp(40px, 5vw, 64px); align-items: start; }
  .article { max-width: 720px; display: flex; flex-direction: column; gap: var(--space-4); }
  .block { padding: clamp(20px, 3vw, 28px); border-radius: var(--radius-md); display: flex; flex-direction: column; gap: var(--space-3); }
  .block__title { font-size: var(--fs-24); font-weight: 700; line-height: 1.25; }
  .block__p { font-size: var(--fs-16); line-height: 1.7; color: var(--color-text-body); }
  .links { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-2); }

  @media (min-width: 768px) {
    .cover__stage { aspect-ratio: 21 / 9; }
  }
  @media (min-width: 1024px) {
    .layout { grid-template-columns: 220px minmax(0, 720px); }
  }
</style>

<script>
  // «Volver a proyectos»: si el visitante viene de la home, usa history.back() para conservar el scroll
  function init() {
    const link = document.querySelector<HTMLAnchorElement>('[data-back-to-projects]');
    if (!link) return;
    link.addEventListener('click', (e) => {
      let prev: string | null = null;
      try { prev = sessionStorage.getItem('prev-path'); } catch { /* sin almacenamiento */ }
      if (prev === '/' && history.length > 1) {
        e.preventDefault();
        history.back();
      }
    });
  }
  document.addEventListener('astro:page-load', init);
</script>
