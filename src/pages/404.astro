---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Página no encontrada · Jeiko Mendiguri" description="Esta página no existe." noindex>
  <main class="notfound">
    <div class="notfound__card glass">
      <span class="notfound__mark" aria-hidden="true">JM</span>
      <h1 class="notfound__title">Esta página no existe.</h1>
      <p class="notfound__text">Puede que el enlace haya cambiado.</p>
      <a class="btn btn--dark" href="/"><Icon name="arrow-left" size={20} />Volver al inicio</a>
    </div>
  </main>
</BaseLayout>

<style>
  .notfound { position: relative; z-index: 1; min-height: 100vh; display: grid; place-items: center; padding: var(--space-6); }
  .notfound__card {
    width: 100%; max-width: 520px; display: flex; flex-direction: column; align-items: center; gap: var(--space-5);
    text-align: center; padding: clamp(32px, 6vw, 56px) clamp(20px, 5vw, 48px);
    border-radius: var(--radius-lg); box-shadow: var(--shadow-md);
  }
  .notfound__mark {
    width: 64px; height: 64px; border-radius: 18px; display: grid; place-items: center;
    background: var(--color-btn-dark); color: var(--color-primary-contrast); font-weight: 700; font-size: var(--fs-24);
  }
  .notfound__title { font-size: clamp(var(--fs-32), 5vw, var(--fs-40)); line-height: 1.15; font-weight: 700; letter-spacing: -0.015em; }
  .notfound__text { font-size: var(--fs-18); line-height: 1.6; color: var(--color-text-muted); }
  .notfound__card .btn { margin-top: var(--space-2); }
</style>
