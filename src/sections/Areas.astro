---
import SectionHeader from '../components/SectionHeader.astro';
import Icon from '../components/Icon.astro';
import { getAreas } from '../lib/content';
import ui from '../data/sections.json';

const areas = await getAreas();
---
<section class="container section" aria-labelledby="h-areas">
  <SectionHeader eyebrow={ui.areas.eyebrow} title={ui.areas.title} titleId="h-areas" />
  <ul class="areas">
    {areas.map((a) => (
      <li class="area glass">
        <span class="area__icon"><Icon name={a.icon} size={22} /></span>
        <h3 class="area__title">{a.title}</h3>
        <p class="area__desc">{a.description}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .areas { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap: var(--space-4); margin-top: var(--space-8); }
  .area { display: flex; flex-direction: column; gap: 14px; padding: var(--space-6); border-radius: var(--radius-md); box-shadow: var(--shadow-md); }
  .area__icon {
    width: 48px; height: 48px; border-radius: 14px; display: grid; place-items: center;
    background: var(--color-primary-soft); color: var(--color-primary);
  }
  .area__title { font-size: var(--fs-18); font-weight: 700; line-height: 1.3; }
  .area__desc { font-size: var(--fs-16); line-height: 1.6; color: var(--color-text-muted); }
</style>
