---
import { Picture } from 'astro:assets';
import Icon from '../components/Icon.astro';
import Chip from '../components/Chip.astro';
import { getProfile } from '../lib/content';
import ui from '../data/sections.json';

const p = await getProfile();
const at = p.headline.indexOf(p.gradientWord);
const before = at >= 0 ? p.headline.slice(0, at) : p.headline;
const accent = at >= 0 ? p.gradientWord : '';
const after = at >= 0 ? p.headline.slice(at + p.gradientWord.length) : '';
---
<section class="hero container section" aria-labelledby="hero-title">
  <div class="hero__grid">
    <div class="hero__text">
      <p class="eyebrow">{p.greeting}</p>
      <div class="hero__titles">
        <h1 class="hero__name" id="hero-title">{p.name}</h1>
        <p class="hero__headline">{before}<span class="gradient-text">{accent}</span>{after}</p>
      </div>
      <p class="hero__tagline">{p.tagline}</p>
      <p class="hero__desc">{p.description}</p>
      <div class="hero__cta">
        <a class="btn btn--dark" href="#proyectos">{ui.hero.viewProjects}<Icon name="arrow-right" size={20} /></a>
        <a class="btn btn--glass" href={p.contact.whatsappUrl} target="_blank" rel="noopener noreferrer">
          <span class="hero__wa"><Icon name="message-circle" size={20} /></span>{ui.hero.whatsapp}
        </a>
      </div>
    </div>

    <div class="hero__photo-wrap">
      <span class="hero__glow hero__glow--a" aria-hidden="true"></span>
      <span class="hero__glow hero__glow--b" aria-hidden="true"></span>
      <span class="hero__glow hero__glow--c" aria-hidden="true"></span>
      <span class="hero__glow hero__glow--ring" aria-hidden="true"></span>
      <div class="hero__photo">
        <Picture
          src={p.photo}
          formats={['avif', 'webp']}
          widths={[220, 440]}
          sizes="(min-width: 900px) 440px, 80vw"
          alt={p.photoAlt}
          loading="eager"
          fetchpriority="high"
          class="hero__img"
        />
      </div>
    </div>
  </div>

  <div class="hero__sectors">
    <p class="hero__sectors-label">{ui.hero.sectors}</p>
    <ul class="hero__chips">
      {p.sectors.map((s) => <li><Chip variant="pill">{s}</Chip></li>)}
    </ul>
  </div>
</section>

<style>
  .hero.section { padding-top: clamp(48px, 7vw, 88px); padding-bottom: clamp(40px, 5vw, 64px); }
  .hero__grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: clamp(40px, 5vw, 72px); align-items: center;
  }
  .hero__text { display: flex; flex-direction: column; gap: var(--space-5); }
  .hero__titles { display: flex; flex-direction: column; gap: 10px; }
  .hero__name { font-size: clamp(var(--fs-40), 5vw, var(--fs-56)); line-height: 1.05; font-weight: 700; letter-spacing: -0.02em; }
  .hero__headline { font-size: clamp(var(--fs-24), 2.6vw, var(--fs-32)); line-height: 1.2; font-weight: 700; letter-spacing: -0.01em; }
  .gradient-text { background: var(--color-gradient); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hero__tagline { font-size: var(--fs-20); line-height: 1.45; font-weight: 600; max-width: 520px; }
  .hero__desc { font-size: var(--fs-16); line-height: 1.65; color: var(--color-text-muted); max-width: 560px; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--space-3); padding-top: var(--space-1); }
  .hero__wa { color: var(--color-primary); display: inline-flex; }

  /* Foto circular sin marco; el acento son manchas azules estáticas (valores del diseño) */
  .hero__photo-wrap { position: relative; width: 100%; max-width: 440px; justify-self: center; }
  .hero__photo { position: relative; z-index: 1; aspect-ratio: 1 / 1; width: 100%; }
  .hero__photo :global(.hero__img) { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
  .hero__glow { position: absolute; z-index: 0; pointer-events: none; }
  .hero__glow--a {
    inset: -30% -60% -30% -15%;
    background:
      radial-gradient(closest-side at 58% 46%, color-mix(in srgb, var(--color-primary) 42%, transparent), color-mix(in srgb, var(--color-primary) 22%, transparent) 50%, transparent 100%),
      radial-gradient(closest-side at 32% 74%, color-mix(in srgb, var(--color-primary) 34%, transparent), color-mix(in srgb, var(--color-primary) 16%, transparent) 50%, transparent 100%);
    filter: blur(24px);
  }
  .hero__glow--b {
    top: -10%; bottom: 20%; left: 110%; right: -90%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--color-primary) 30%, transparent), color-mix(in srgb, var(--color-primary) 15%, transparent) 55%, transparent 100%);
    filter: blur(24px);
  }
  .hero__glow--c {
    top: 55%; bottom: -15%; left: 100%; right: -95%;
    background: radial-gradient(farthest-side at 50% 50%, color-mix(in srgb, var(--color-primary) 32%, transparent) 0%, color-mix(in srgb, var(--color-primary) 30%, transparent) 40%, color-mix(in srgb, var(--color-primary) 18%, transparent) 70%, transparent 100%);
    filter: blur(40px);
  }
  .hero__glow--ring {
    top: 0; left: 0; width: 100%; aspect-ratio: 1 / 1; border-radius: 50%;
    box-shadow: 56px 0 64px 12px color-mix(in srgb, var(--color-primary) 20%, transparent);
  }

  .hero__sectors {
    margin-top: clamp(48px, 6vw, 72px); display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5);
    padding-top: var(--space-6); border-top: 1px solid var(--color-border);
  }
  .hero__sectors-label { font-size: var(--fs-14); font-weight: 700; color: var(--color-text-muted); letter-spacing: 0.04em; }
  .hero__chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }

  /* CA-01: en móvil los botones van antes de la descripción para que «Ver proyectos» quede visible sin scroll */
  @media (max-width: 767px) {
    .hero__cta { order: 1; }
    .hero__desc { order: 2; }
  }
</style>
