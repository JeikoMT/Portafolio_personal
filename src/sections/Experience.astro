---
import SectionHeader from '../components/SectionHeader.astro';
import Icon from '../components/Icon.astro';
import { getExperience } from '../lib/content';
import ui from '../data/sections.json';

const { main, secondary } = await getExperience();
---
<section id="experiencia" class="container section" aria-labelledby="h-exp">
  <SectionHeader eyebrow={ui.experience.eyebrow} title={ui.experience.title} titleId="h-exp" />

  <ol class="timeline">
    {main.map((e) => (
      <li class="job solid">
        <span class="job__dot" aria-hidden="true"></span>
        <div class="job__top">
          <span class="job__sector"><Icon name="briefcase" size={14} />{e.sector}</span>
          <span class="job__period">{e.periodLabel}</span>
        </div>
        <h3 class="job__role">{e.role}</h3>
        <p class="job__company">{e.company}</p>
        <ul class="job__list">
          {e.highlights.map((h) => <li><span class="job__bullet" aria-hidden="true"></span><span>{h}</span></li>)}
        </ul>
      </li>
    ))}
  </ol>

  {secondary.map((s) => (
    <aside class="clinic">
      <p class="clinic__eyebrow">{ui.experience.secondary}</p>
      <div class="clinic__head">
        <p class="clinic__role">{s.role} · <span>{s.company}</span></p>
        <p class="clinic__period">{s.periodLabel}</p>
      </div>
      <p class="clinic__text">{s.highlights.join('. ')}</p>
    </aside>
  ))}
</section>

<style>
  .timeline { position: relative; display: flex; flex-direction: column; gap: var(--space-4); margin-top: var(--space-8); padding-left: 36px; max-width: 920px; }
  .timeline::before { content: ''; position: absolute; left: 9px; top: 12px; bottom: 12px; width: 2px; background: rgba(29, 78, 216, 0.18); }
  .job { position: relative; padding: clamp(18px, 2.5vw, 28px); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); }
  .job__dot {
    position: absolute; left: -36px; top: 30px; width: 20px; height: 20px; border-radius: 50%;
    background: var(--color-surface-solid); border: 4px solid var(--color-primary);
  }
  .job__top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2) var(--space-4); }
  .job__sector {
    display: inline-flex; align-items: center; gap: 6px; min-height: 28px; padding: 0 10px; border-radius: var(--radius-pill);
    background: var(--color-primary-soft); color: var(--color-primary); font-size: var(--fs-14); font-weight: 600;
  }
  .job__period { font-size: var(--fs-14); font-weight: 600; color: var(--color-text-muted); }
  .job__role { margin-top: 14px; font-size: var(--fs-20); font-weight: 700; line-height: 1.3; }
  .job__company { margin-top: 2px; font-size: var(--fs-16); font-weight: 600; color: var(--color-primary); }
  .job__list { margin-top: 14px; display: flex; flex-direction: column; gap: var(--space-2); }
  .job__list li { display: flex; gap: 10px; font-size: var(--fs-16); line-height: 1.55; color: var(--color-text-body); }
  .job__bullet { flex: none; width: 6px; height: 6px; border-radius: 50%; background: var(--color-primary); margin-top: 10px; }

  .clinic {
    margin-top: var(--space-6); max-width: 920px; display: flex; flex-direction: column; gap: 10px; padding: 20px 24px;
    border-radius: var(--radius-md); background: var(--color-surface-solid); border: 1px dashed rgba(29, 78, 216, 0.3);
  }
  .clinic__eyebrow { font-size: var(--fs-14); font-weight: 700; letter-spacing: 0.08em; color: var(--color-text-muted); text-transform: uppercase; }
  .clinic__head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; }
  .clinic__role { font-size: var(--fs-16); font-weight: 700; }
  .clinic__role span { color: var(--color-primary); }
  .clinic__period { font-size: var(--fs-14); font-weight: 600; color: var(--color-text-muted); }
  .clinic__text { font-size: var(--fs-16); line-height: 1.55; color: var(--color-text-muted); }
</style>
