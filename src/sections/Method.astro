---
import SectionHeader from '../components/SectionHeader.astro';
import { getMethod } from '../lib/content';
import ui from '../data/sections.json';

const steps = await getMethod();
---
<section class="container section" aria-labelledby="h-met">
  <SectionHeader eyebrow={ui.method.eyebrow} title={ui.method.title} titleId="h-met" />
  <ol class="steps">
    {steps.map((s) => (
      <li class="step">
        <span class="step__num">{s.step}</span>
        <div class="step__body">
          <h3 class="step__title">{s.title}</h3>
          <p class="step__desc">{s.description}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .steps { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-6); margin-top: var(--space-8); }
  .step { position: relative; display: flex; gap: var(--space-4); }
  .step:not(:last-child)::after {
    content: ''; position: absolute; left: 24px; top: 56px; bottom: -24px; width: 1px; background: rgba(29, 78, 216, 0.3);
  }
  .step__num {
    position: relative; flex: none; width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center;
    background: var(--color-surface-solid); border: 1px solid rgba(29, 78, 216, 0.3); color: var(--color-primary); font-size: var(--fs-16); font-weight: 700;
  }
  .step__body { display: flex; flex-direction: column; gap: var(--space-2); padding-right: var(--space-2); }
  .step__title { font-size: var(--fs-18); font-weight: 700; }
  .step__desc { font-size: var(--fs-16); line-height: 1.6; color: var(--color-text-muted); }

  @media (min-width: 768px) {
    .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px 16px; }
    .step { flex-direction: column; }
    .step:not(:last-child)::after { display: none; }
  }
  @media (min-width: 1100px) {
    .steps { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .step:not(:last-child)::after {
      display: block; left: 56px; right: -16px; top: 24px; bottom: auto; width: auto; height: 1px;
    }
  }
</style>
