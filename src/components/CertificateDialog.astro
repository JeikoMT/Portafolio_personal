---
import Icon from './Icon.astro';
import ui from '../data/sections.json';
---
<dialog class="cdialog" id="cert-dialog" aria-labelledby="cert-dialog-title" data-error-text={ui.certificates.error}>
  <div class="cdialog__inner">
    <header class="cdialog__head">
      <p class="cdialog__meta" data-cert-meta></p>
      <h2 class="cdialog__title" id="cert-dialog-title" data-cert-title></h2>
    </header>
    <div class="cdialog__media">
      <img class="cdialog__img" data-cert-img alt="" />
      <div class="cdialog__error" role="alert" data-cert-error hidden>
        <Icon name="image-off" size={32} />
        <p>{ui.certificates.error}</p>
      </div>
    </div>
    <div class="cdialog__foot">
      <button type="button" class="btn btn--dark" data-cert-close><Icon name="x" size={18} />{ui.certificates.close}</button>
    </div>
  </div>
</dialog>

<style>
  .cdialog {
    width: min(760px, calc(100vw - 32px)); max-height: calc(100vh - 32px); padding: 0; border: 0; border-radius: var(--radius-lg);
    background: var(--color-surface-solid); color: var(--color-text); box-shadow: 0 24px 64px rgba(11, 27, 58, 0.25); overflow: auto;
  }
  .cdialog::backdrop { background: rgba(11, 27, 58, 0.55); }
  .cdialog__inner { display: flex; flex-direction: column; }
  .cdialog__head { padding: 20px 24px 12px; }
  .cdialog__meta { font-size: var(--fs-14); font-weight: 600; color: var(--color-text-muted); }
  .cdialog__title { margin-top: 4px; font-size: var(--fs-20); font-weight: 700; line-height: 1.3; }
  .cdialog__media { padding: 0 24px; }
  .cdialog__img {
    display: block; width: 100%; max-width: 100%; margin: 0 auto; height: auto; border-radius: var(--radius-md);
    border: 1px solid rgba(11, 27, 58, 0.08); background: var(--color-surface-solid);
  }
  .cdialog__img[data-orientation='vertical'] { max-width: 420px; }
  .cdialog__error {
    aspect-ratio: 1.414 / 1; border-radius: var(--radius-md); background: var(--color-error-soft); border: 1px solid rgba(185, 28, 28, 0.25);
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-3); padding: var(--space-6);
    text-align: center; color: var(--color-error); font-size: var(--fs-16); font-weight: 600;
  }
  .cdialog__error[hidden], .cdialog__img[hidden] { display: none; }
  .cdialog__foot { display: flex; justify-content: flex-end; padding: 16px 24px 24px; }
</style>

<script>
  let ac: AbortController | undefined;

  function init() {
    ac?.abort();
    ac = new AbortController();
    const { signal } = ac;

    const dialog = document.querySelector<HTMLDialogElement>('#cert-dialog');
    if (!dialog) return;
    const img = dialog.querySelector<HTMLImageElement>('[data-cert-img]')!;
    const err = dialog.querySelector<HTMLElement>('[data-cert-error]')!;
    const title = dialog.querySelector<HTMLElement>('[data-cert-title]')!;
    const meta = dialog.querySelector<HTMLElement>('[data-cert-meta]')!;
    let trigger: HTMLElement | null = null;

    const showError = () => {
      img.hidden = true;
      err.hidden = false;
    };
    img.addEventListener('error', showError, { signal });
    img.addEventListener('load', () => { img.hidden = false; err.hidden = true; }, { signal });

    document.querySelectorAll<HTMLButtonElement>('[data-cert-open]').forEach((btn) => {
      btn.addEventListener('click', () => {
        trigger = btn;
        title.textContent = btn.dataset.title ?? '';
        meta.textContent = btn.dataset.meta ?? '';
        img.hidden = false;
        err.hidden = true;
        img.alt = btn.dataset.alt ?? '';
        img.dataset.orientation = btn.dataset.orientation ?? 'horizontal';
        // `data-force-error` solo lo usan las pruebas para simular una imagen rota (CA-10)
        img.src = btn.dataset.forceError === 'true' ? '/__no-existe__.webp' : (btn.dataset.src ?? '');
        dialog.showModal();
      }, { signal });
    });

    dialog.querySelector('[data-cert-close]')?.addEventListener('click', () => dialog.close(), { signal });
    dialog.addEventListener('close', () => {
      img.removeAttribute('src');
      trigger?.focus();
    }, { signal });
    // Clic en el fondo oscuro cierra el diálogo
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); }, { signal });
  }

  document.addEventListener('astro:page-load', init);
</script>
