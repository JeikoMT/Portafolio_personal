---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import ui from '../data/sections.json';

interface Props {
  title: string;
  issuer: string;
  date: string;
  hours: number;
  category: string;
  image: ImageMetadata;
  imageAlt: string;
  orientation: 'horizontal' | 'vertical';
}
const { title, issuer, date, hours, category, image, imageAlt, orientation } = Astro.props;
const large = await getImage({ src: image, width: 1400, format: 'webp' });
const meta = `${issuer} · ${date} · ${hours} ${ui.certificates.hours}`;
---
<article class="cert glass">
  <div class:list={['cert__thumb', orientation === 'vertical' && 'cert__thumb--top']}>
    <Picture src={image} formats={['avif', 'webp']} widths={[320, 520]} sizes="(min-width: 640px) 260px, 90vw" alt={imageAlt} loading="lazy" class="cert__img" />
  </div>
  <div class="cert__body">
    <span class="cert__cat">{category}</span>
    <h4 class="cert__title">{title}</h4>
    <p class="cert__meta">{meta}</p>
    <button
      type="button"
      class="cert__btn"
      data-cert-open
      data-title={title}
      data-meta={meta}
      data-src={large.src}
      data-alt={imageAlt}
      data-orientation={orientation}
    >
      <Icon name="eye" size={18} />{ui.certificates.view}
    </button>
  </div>
</article>

<style>
  .cert { display: flex; flex-direction: column; overflow: hidden; border-radius: var(--radius-md); }
  .cert__thumb {
    margin: 8px 8px 0; aspect-ratio: 1.414 / 1; border-radius: 12px; overflow: hidden;
    border: 1px solid rgba(11, 27, 58, 0.08); background: var(--color-surface-solid);
  }
  .cert__thumb :global(.cert__img) { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .cert__thumb--top :global(.cert__img) { object-position: top; }
  .cert__body { display: flex; flex-direction: column; gap: var(--space-2); padding: 16px 18px 18px; flex: 1; }
  .cert__cat {
    align-self: flex-start; display: inline-flex; align-items: center; min-height: 24px; padding: 0 10px; border-radius: var(--radius-pill);
    background: var(--color-primary-soft); color: var(--color-primary); font-size: var(--fs-12); font-weight: 700;
  }
  .cert__title { margin: 0; flex: 1; font-size: var(--fs-16); font-weight: 700; line-height: 1.35; }
  .cert__meta { font-size: var(--fs-14); color: var(--color-text-muted); line-height: 1.5; }
  .cert__btn {
    margin-top: 6px; align-self: flex-start; display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; padding: 0 16px;
    border-radius: var(--radius-pill); border: 1px solid rgba(29, 78, 216, 0.25); background: var(--color-surface-solid);
    color: var(--color-primary); font: 600 var(--fs-14) var(--font-body); cursor: pointer; transition: background var(--motion-hover);
  }
  .cert__btn:hover { background: var(--color-primary-soft); }
</style>
