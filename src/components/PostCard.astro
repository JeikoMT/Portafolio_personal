---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import ui from '../data/sections.json';

interface Props { title: string; summary: string; dateLabel: string; url: string; cover: ImageMetadata; coverAlt: string; }
const { title, summary, dateLabel, url, cover, coverAlt } = Astro.props;
---
<article class="post">
  <div class="post__cover">
    <Picture src={cover} formats={['avif', 'webp']} widths={[320, 480, 640]} sizes="(min-width: 640px) 320px, 90vw" alt={coverAlt} loading="lazy" class="post__img" />
  </div>
  <div class="post__body">
    <p class="post__date">{dateLabel}</p>
    <h3 class="post__title">{title}</h3>
    <p class="post__summary">{summary}</p>
    <a class="post__link" href={url} target="_blank" rel="noopener noreferrer" aria-label={`${ui.posts.link}: ${title}`}>
      {ui.posts.link}<Icon name="external-link" size={16} />
    </a>
  </div>
</article>

<style>
  .post {
    display: flex; flex-direction: column; overflow: hidden; border-radius: var(--radius-md);
    background: var(--color-surface-solid); border: 1px solid var(--color-border); box-shadow: var(--shadow-sm);
  }
  .post__cover { aspect-ratio: 4 / 5; background: #0b0f1a; }
  .post__cover :global(.post__img) { width: 100%; height: 100%; object-fit: cover; }
  .post__body { display: flex; flex-direction: column; gap: var(--space-2); padding: 18px 20px 20px; flex: 1; }
  .post__date { font-size: var(--fs-14); font-weight: 600; color: var(--color-text-muted); }
  .post__title { font-size: var(--fs-18); font-weight: 700; line-height: 1.35; }
  .post__summary {
    flex: 1; font-size: var(--fs-16); line-height: 1.55; color: var(--color-text-muted);
    display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .post__link {
    display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-size: var(--fs-14); font-weight: 700;
    color: var(--color-primary); text-decoration: none;
  }
  .post__link:hover { color: var(--color-text); }
</style>
