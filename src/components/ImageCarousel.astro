---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import ui from '../data/sections.json';

interface Props { title: string; slides: { image: ImageMetadata; label: string }[]; }
const { title, slides } = Astro.props;
const total = slides.length;
---
<figure class="carousel glass" data-carousel data-screen-prefix={ui.projectPage.screen}>
  <div
    class="carousel__stage"
    role="region"
    aria-roledescription={ui.projectPage.carouselRole}
    aria-label={`${ui.projectPage.carouselLabel} ${title}`}
    tabindex="0"
    data-carousel-stage
  >
    {slides.map((s, i) => (
      <div class="carousel__slide" data-slide data-label={s.label} aria-hidden={i === 0 ? 'false' : 'true'} style={`opacity:${i === 0 ? 1 : 0}`}>
        <Image
          src={s.image}
          alt={`${ui.projectPage.carouselLabel} ${title}: ${s.label}`}
          widths={[640, 960, 1280]}
          sizes="(min-width: 1264px) 1200px, 94vw"
          format="webp"
          loading={i === 0 ? 'eager' : 'lazy'}
          class="carousel__img"
        />
      </div>
    ))}
    {total > 1 && (
      <>
        <button type="button" class="carousel__nav carousel__nav--prev" data-prev aria-label={ui.projectPage.prev}>
          <span class="carousel__arrow"><Icon name="chevron-left" size={22} /></span>
        </button>
        <button type="button" class="carousel__nav carousel__nav--next" data-next aria-label={ui.projectPage.next}>
          <span class="carousel__arrow"><Icon name="chevron-right" size={22} /></span>
        </button>
      </>
    )}
    <span class="carousel__counter" aria-live="polite" data-counter>{`1 / ${total}`}</span>
  </div>

  {total > 1 && (
    <div class="carousel__dots">
      {slides.map((s, i) => (
        <button
          type="button"
          class="carousel__dot"
          data-dot
          aria-label={`${ui.projectPage.goTo} ${s.label}`}
          aria-current={i === 0 ? 'true' : 'false'}
        ></button>
      ))}
    </div>
  )}

  <figcaption class="carousel__caption">
    <Icon name="monitor" size={14} /><span data-caption>{`${ui.projectPage.screen} ${slides[0]?.label ?? ''}`}</span>
    <span class="carousel__fict">· {ui.projectPage.fictitious}</span>
  </figcaption>
</figure>

<style>
  .carousel { margin: 0; padding: 10px; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); }
  .carousel__stage {
    position: relative; aspect-ratio: 16 / 10; border-radius: var(--radius-md); overflow: hidden;
    border: 1px solid rgba(29, 78, 216, 0.1); background: var(--color-media-stage); outline-offset: -3px;
  }
  .carousel__slide { position: absolute; inset: 0; transition: opacity var(--motion-fade); }
  .carousel__slide :global(.carousel__img) { width: 100%; height: 100%; object-fit: contain; }
  .carousel__nav {
    position: absolute; top: 0; bottom: 0; width: 50%; border: 0; padding: 0 16px; background: transparent; cursor: pointer;
    display: flex; align-items: center; opacity: 0; transition: opacity var(--motion-hover);
  }
  .carousel__nav--prev { left: 0; justify-content: flex-start; cursor: w-resize; }
  .carousel__nav--next { right: 0; justify-content: flex-end; cursor: e-resize; }
  .carousel__nav:hover, .carousel__nav:focus-visible { opacity: 1; }
  .carousel__arrow {
    width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center;
    background: var(--color-surface-strong); color: var(--color-text); box-shadow: 0 12px 32px rgba(11, 27, 58, 0.2);
  }
  .carousel__counter {
    position: absolute; right: 12px; bottom: 12px; pointer-events: none; display: inline-flex; align-items: center; min-height: 28px;
    padding: 0 10px; border-radius: var(--radius-pill); background: rgba(11, 27, 58, 0.72); color: #fff; font-size: var(--fs-12); font-weight: 600;
  }
  .carousel__dots { display: flex; justify-content: center; gap: 6px; padding-top: 12px; }
  .carousel__dot {
    position: relative; width: 8px; height: 8px; padding: 0; border: 0; border-radius: var(--radius-pill); cursor: pointer;
    background: rgba(29, 78, 216, 0.25); transition: width var(--motion-hover), background var(--motion-hover);
  }
  /* Área táctil ampliada sin cambiar el aspecto del punto */
  .carousel__dot::after { content: ''; position: absolute; inset: -18px -6px; }
  .carousel__dot[aria-current='true'] { width: 24px; background: var(--color-primary); }
  .carousel__caption {
    display: flex; align-items: center; gap: 6px; padding: 10px 6px 2px; font-size: var(--fs-12); font-weight: 600; color: var(--color-text-muted);
  }
  .carousel__fict { margin-left: 2px; }
</style>

<script>
  let ac: AbortController | undefined;

  function init() {
    ac?.abort();
    ac = new AbortController();
    const { signal } = ac;

    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
      const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
      const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
      const counter = root.querySelector<HTMLElement>('[data-counter]')!;
      const caption = root.querySelector<HTMLElement>('[data-caption]')!;
      const stage = root.querySelector<HTMLElement>('[data-carousel-stage]')!;
      const prefix = root.dataset.screenPrefix ?? '';
      let current = 0;

      const show = (n: number) => {
        current = (n + slides.length) % slides.length;
        slides.forEach((s, i) => {
          s.style.opacity = i === current ? '1' : '0';
          s.setAttribute('aria-hidden', String(i !== current));
        });
        dots.forEach((d, i) => d.setAttribute('aria-current', String(i === current)));
        counter.textContent = `${current + 1} / ${slides.length}`;
        caption.textContent = `${prefix} ${slides[current].dataset.label ?? ''}`;
      };

      root.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1), { signal });
      root.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1), { signal });
      dots.forEach((d, i) => d.addEventListener('click', () => show(i), { signal }));
      stage.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') { e.preventDefault(); show(current - 1); }
        if (e.key === 'ArrowRight') { e.preventDefault(); show(current + 1); }
      }, { signal });
    });
  }

  document.addEventListener('astro:page-load', init);
</script>
