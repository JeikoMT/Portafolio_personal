---
interface Props { label: string; }
const { label } = Astro.props;
---
<div class="strip glass">
  <p class="strip__label">{label}</p>
  <!-- Región desplazable accesible por teclado (CA-03): el scroll es interno, nunca de la página -->
  <div class="strip__scroll" role="region" aria-label={label} tabindex="0">
    <div class="strip__inner"><slot /></div>
  </div>
</div>

<style>
  .strip {
    display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-3) var(--space-6); align-items: center;
    padding: 18px clamp(16px, 2vw, 24px); border-radius: var(--radius-md);
  }
  .strip__label { font-size: var(--fs-16); font-weight: 700; }
  .strip__scroll {
    min-width: 0; overflow-x: auto; scrollbar-width: thin;
    -webkit-mask-image: linear-gradient(90deg, #000 80%, transparent);
    mask-image: linear-gradient(90deg, #000 80%, transparent);
  }
  .strip__inner { display: flex; flex-wrap: nowrap; gap: var(--space-2); width: max-content; padding-right: 48px; }

  @media (min-width: 768px) {
    .strip { grid-template-columns: 200px minmax(0, 1fr); }
    .strip__scroll { overflow: visible; -webkit-mask-image: none; mask-image: none; }
    .strip__inner { flex-wrap: wrap; width: auto; padding-right: 0; }
  }
</style>
