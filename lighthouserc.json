{
  "ci": {
    "collect": {
      "startServerCommand": "npx astro preview --port 4401",
      "startServerReadyPattern": "4401",
      "url": [
        "http://localhost:4401/",
        "http://localhost:4401/proyectos/interviewnotes"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    }
  }
}
